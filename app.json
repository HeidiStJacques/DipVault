{
  "expo": {
    "name": "DipVault",
    "slug": "dipvault",
    "scheme": "dipvault",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dipvault.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "DipVault uses your camera so you can take photos of nail products, swatches, and looks to add to your personal collection.",
        "NSPhotoLibraryUsageDescription": "DipVault accesses your photo library so you can select photos of nail products, swatches, and looks to add to your personal collection."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#f7f4ef"
      },
      "package": "com.dipvault.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#f7f4ef",
          "imageWidth": 200
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.250963743906-l5ssutnsk4sksgk23i303f2ggkvcl0gc"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1e76aa10-8e9f-466f-9d18-2d4bde63632c"
      }
    }
  }
}
